{
 "$schema":"https://openapi.vercel.sh/vercel.json",
 "framework":"vite",
 "buildCommand":"npm run build",
 "outputDirectory":"dist",
 "functions":{"api/index.ts":{"maxDuration":60}},
 "rewrites":[{"source":"/api/:path*","destination":"/api"}],
 "headers":[{"source":"/:path*","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"no-referrer"},{"key":"X-Frame-Options","value":"DENY"}]}]
}
