# Local: deixe Supabase vazio. Produção: configure ambos.
# Nunca use prefixo VITE_ para segredos.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# E-mails distintos, configurados privadamente.
KAYOHAN_EMAIL=
ARIELLE_EMAIL=
# OpenRouter tem prioridade quando sua chave está presente.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=3001
# Lista de origens exatas separadas por vírgula, sem caminho.
# APP_ORIGIN=https://finance.example.com

# Lembretes: chave Resend e remetente de domínio verificado (somente servidor).
RESEND_API_KEY=
REMINDER_FROM=
# Token aleatório compartilhado com Supabase Vault; nunca use VITE_.
REMINDER_CRON_SECRET=
